node_modules
dist
dist-ssr
*.local

# Vite inlines every VITE_-prefixed variable into the client bundle, so an
# .env here is public by construction. Committing one is still wrong: it pins
# a local machine's ports into everyone else's checkout. Only the example is
# tracked.
.env
.env.*
!.env.example

