# Copy to `.env.local` for local overrides. Everything here is PUBLIC: Vite
# inlines every VITE_-prefixed variable into the client bundle, so nothing
# secret may ever appear in this file or any .env file in this directory.
# The API is anonymous today and needs no credentials of any kind.

# Where `npm run dev` proxies /api. Defaults to the local backend's port.
# Start the backend with: python -m nflfp.api --port 8010
VITE_DEV_API_PROXY=http://127.0.0.1:8010

# Absolute API origin, for a deployment where the frontend is served from a
# different host than the API. Leave unset to call the same origin, which is
# the correct configuration when both sit behind one domain.
# VITE_API_BASE_URL=
