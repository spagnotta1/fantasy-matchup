# Copy to .env and fill in, or set these in your shell.

# Postgres warehouse. Railway injects DATABASE_URL automatically when you add a
# Postgres service and reference it; set it manually for local work.
# sslmode is added for you: `disable` for localhost, `require` for anything else.
DATABASE_URL=postgresql://nflfp:nflfp@localhost:55432/nflfp

# Optional. Overrides DATABASE_URL — useful for pointing a local run at staging.
# NFLFP_PG_URL=

# Optional. Force a specific sslmode instead of the localhost/remote default.
# NFLFP_PG_SSLMODE=require

# Optional. Local DuckDB exploration file (default: data/nfl.duckdb).
# NFLFP_DB=

# Optional. Lifts the anonymous GitHub API rate limit (60/hr -> 5000/hr) used to
# resolve which nflverse season files exist. Only needed if you run the pipeline
# very frequently.
# GITHUB_TOKEN=

# ---- application settings (nflfp.config.Settings) ------------------------
# All optional; the defaults are correct for local development.

# local | test | staging | production. Drives log format and TLS expectations.
# ENVIRONMENT=local
# LOG_LEVEL=INFO
# LOG_JSON=false

# Connection pool. Size these against Railway's Postgres connection limit
# divided by the number of running instances (API + worker + scheduler).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# Server-side statement timeout for API sessions, in ms. A runaway query holds
# a pooled connection, and a starved pool turns one slow endpoint into an
# outage. 0 disables.
# DB_STATEMENT_TIMEOUT_MS=15000

# How long to wait for a TCP connection before giving up. libpq's default is to
# wait effectively forever, which made /health take 130 seconds to report a
# dead database instead of failing fast.
# DB_CONNECT_TIMEOUT_SECONDS=10

# Explicit DSN override for tests or a one-off run against a copy of
# production. Deliberately NOT named DATABASE_URL — that variable is read by
# nflfp.pg.dsn(), which normalises the scheme and adds sslmode.
# DATABASE_URL_OVERRIDE=

# Scoring format used when a request doesn't name one.
# DEFAULT_SCORING_PROFILE=half_ppr

# ---- caching (Layer 6) ----------------------------------------------------
# Railway injects this when you add a Redis service and reference it as
# ${{Redis.REDIS_URL}}. Unset means no cache — a supported configuration, not a
# degraded one: every response is computed, exactly as before Layer 6.
# REDIS_URL=

# Master switch. Turning it off is the first diagnostic step when a response
# looks stale, and it must be one variable rather than a redeploy.
# CACHE_ENABLED=true

# redis | memory | null. `memory` is correct ONLY for a single instance: a
# namespace bump performed by another instance would never reach it, and the
# symptom is superseded projections served indefinitely by one replica.
# CACHE_BACKEND=redis

# Socket timeout for cache operations. A cache lookup must never be slower than
# the query it replaces; without a timeout a stalled Redis turns every cached
# endpoint into a hang.
# CACHE_TIMEOUT_SECONDS=0.25

# How long an instance may reuse a locally held publish epoch — the upper bound
# on how long a publish takes to become visible, traded against re-reading it
# from Redis on every single request.
# CACHE_EPOCH_TTL_SECONDS=10

# ---- background jobs (Layer 6) -------------------------------------------
# Model the scheduled projection job runs. The frozen foundation by default; a
# challenger is promoted by changing this after it clears the acceptance
# criteria in nflfp/predict/foundation.py, not before.
# PROJECTION_MODEL=shrinkage_eb

# Whether the scheduled projection job publishes its run. Set false in staging
# to generate and store without making anything live.
# JOB_PUBLISH_PROJECTIONS=true

# ---- external providers (Layer 2) ----------------------------------------
# Resolved through nflfp.providers.registry. Set either to "null" to disable a
# feed without removing its scheduled job — the job still runs, still logs, and
# reports zero records, which is what you want during a provider outage.
# WEATHER_PROVIDER=open_meteo      # open_meteo | null
# ODDS_PROVIDER=espn               # espn | null

# How far ahead providers fetch. One NFL week plus slack; Open-Meteo publishes
# 16 days, so values above that gain nothing.
# PROVIDER_HORIZON_DAYS=10
# PROVIDER_TIMEOUT_SECONDS=20
# PROVIDER_RETRY_ATTEMPTS=4
